#import <UIKit/UIKit.h>
#import <sys/sysctl.h>
#import <net/if.h>
#import <net/if_dl.h>
#import <ifaddrs.h>

static UILabel *speedLabel = nil;
static NSTimer *speedTimer = nil;
static uint64_t previousBytes = 0;

static uint64_t getNetworkBytes(void) {
    struct ifaddrs *ifa_list = NULL, *ifa = NULL;
    if (getifaddrs(&ifa_list) < 0) return 0;
    uint64_t bytes = 0;
    for (ifa = ifa_list; ifa != NULL; ifa = ifa->ifa_next) {
        if (ifa->ifa_addr && ifa->ifa_addr->sa_family == AF_LINK) {
            struct if_data *if_data = (struct if_data *)ifa->ifa_data;
            if (if_data) bytes += if_data->ifi_ibytes + if_data->ifi_obytes;
        }
    }
    freeifaddrs(ifa_list);
    return bytes;
}

static NSString *formatSpeed(uint64_t bytesPerSec) {
    if (bytesPerSec < 1024 * 1024) {
        return [NSString stringWithFormat:@"%.1f KB/s", (double)bytesPerSec / 1024.0];
    } else {
        return [NSString stringWithFormat:@"%.2f MB/s", (double)bytesPerSec / (1024.0 * 1024.0)];
    }
}

static void updateSpeed(void) {
    uint64_t currentBytes = getNetworkBytes();
    if (previousBytes > 0 && currentBytes >= previousBytes) {
        uint64_t delta = currentBytes - previousBytes;
        dispatch_async(dispatch_get_main_queue(), ^{
            if (speedLabel) speedLabel.text = formatSpeed(delta);
        });
    }
    previousBytes = currentBytes;
}

%hook UIWindow
- (void)didMoveToWindow {
    %orig;
    static dispatch_once_t onceToken;
    dispatch_once(&onceToken, ^{
        dispatch_async(dispatch_get_main_queue(), ^{
            if (!speedLabel) {
                speedLabel = [[UILabel alloc] initWithFrame:CGRectMake(([UIScreen mainScreen].bounds.size.width / 2) - 35, 6, 70, 16)];
                speedLabel.font = [UIFont systemFontOfSize:9 weight:UIFontWeightBold];
                speedLabel.textColor = [UIColor whiteColor];
                speedLabel.backgroundColor = [[UIColor blackColor] colorWithAlphaComponent:0.5];
                speedLabel.textAlignment = NSTextAlignmentCenter;
                speedLabel.layer.cornerRadius = 4;
                speedLabel.clipsToBounds = YES;
                
                UIWindow *keyWindow = [UIApplication sharedApplication].keyWindow;
                [keyWindow addSubview:speedLabel];
                
                speedTimer = [NSTimer scheduledTimerWithTimeInterval:1.0 repeats:YES block:^(NSTimer * _Nonnull timer) {
                    updateSpeed();
                }];
            }
        });
    });
}
%end
